# Database (Neon / Local Docker Postgres)
# Pooled connection string used at runtime by Prisma
DATABASE_URL=
# Direct connection string used for migrations
DIRECT_URL=

# Public Site URL
# Canonical base URL of the site (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=

# Auth & Security Secrets (generate using: openssl rand -base64 32)
# Secret for Auth.js session signing and verification
AUTH_SECRET=
# Secret for signing guest capability cookies (HMAC-SHA256)
GUEST_COOKIE_SECRET=

# Admin & Notification Emails
# Comma-separated email addresses allowed to sign in to admin
ADMIN_ALLOWLIST=
# Couple / coordinator notification address for gift receipts and alerts
NOTIFY_EMAIL=

# Transactional Email (Resend)
# Resend API key
RESEND_API_KEY=
# Sender email address for magic links and confirmations
EMAIL_FROM=

# Media Storage & Transforms (Cloudinary)
# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key
CLOUDINARY_API_KEY=
# Cloudinary API secret
CLOUDINARY_API_SECRET=
# Upload preset for signed guest uploads
CLOUDINARY_UPLOAD_PRESET=

# Payments (Paystack)
# Paystack secret key (test or live)
PAYSTACK_SECRET_KEY=

# Optional Hardening Sprint Keys
# Sentry DSN for error monitoring
SENTRY_DSN=
# Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST Token for rate limiting
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile secret key (conditional)
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile public site key (conditional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
